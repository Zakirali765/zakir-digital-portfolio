---
import Layout from '../layouts/Layout.astro';
import { path } from '../data/site';
---

<Layout title="Page not found | ZAKIR DIGITAL" noindex>
  <div class="error-page wrap">
    <div class="error-number" aria-hidden="true">
      404
    </div>
    <h1>This page took a wrong turn.</h1>
    <p>The work is still here. Let’s get you back to it.</p>
    <a class="button" href={path()}>
      Back to the portfolio
    </a>
    <p style="margin-top:25px">
      <a class="text-link" href={`${path()}#work`}>
        Explore the selected work
      </a>
    </p>
  </div>
</Layout>
