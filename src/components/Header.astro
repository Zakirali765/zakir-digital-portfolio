---
import { site, path } from '../data/site';
---

<header class="site-header wrap">
  <a class="wordmark" href={path()}>
    <span class="brand-symbol" aria-hidden="true">
      z<span>d</span>
      <i></i>
    </span>
    <span>
      ZAKIR
      <span class="wordmark-digital">
        DIGITAL<span class="brand-period">.</span>
      </span>
    </span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
    Menu <span aria-hidden="true">＋</span>
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Main navigation">
    {site.navigation.map((item) => (
      <a href={`${path()}#${item.id}`}>{item.label}</a>
    ))}
  </nav>
  <a class="button header-cta" href={`${path()}#contact`}>
    {site.primaryAction}
  </a>
</header>
