---
import { site } from '../data/site';
---

<form class="brief-form" id="brief-form" data-email={site.email} data-whatsapp={site.whatsapp}>
  <h3>Ask for a short outline.</h3>
  <p class="form-note">
    Share a few details, then review your email or WhatsApp draft. You send the message yourself;
    opening a draft does not send an enquiry.
  </p>
  <fieldset class="form-grid" disabled>
    <div class="field">
      <label for="your-name">Your name</label>
      <input
        id="your-name"
        name="name"
        type="text"
        required
        maxlength="120"
        autocomplete="name"
        placeholder="Your name"
      />
    </div>
    <div class="field">
      <label for="reply-email">Email</label>
      <input
        id="reply-email"
        name="email"
        type="email"
        required
        maxlength="254"
        autocomplete="email"
        placeholder="you@yourbusiness.co.uk"
      />
    </div>
    <div class="field">
      <label for="business">Business name</label>
      <input
        id="business"
        name="business"
        type="text"
        required
        maxlength="120"
        autocomplete="organization"
        placeholder="Your business"
      />
    </div>
    <div class="field">
      <label for="town">Town / service area</label>
      <input
        id="town"
        name="town"
        type="text"
        required
        maxlength="160"
        autocomplete="address-level2"
        placeholder="Where your business works"
      />
    </div>
    <div class="field full">
      <label for="website">
        Current website <span class="optional">(optional)</span>
      </label>
      <input
        id="website"
        name="website"
        type="url"
        maxlength="500"
        autocomplete="url"
        placeholder="https://"
      />
    </div>
    <div class="field full">
      <label for="interest">What do you need?</label>
      <select id="interest" name="interest">
        <option>Redesign</option>
        <option>New website</option>
        <option>Website + information-only assistant</option>
        <option>Not sure</option>
      </select>
    </div>
    <div class="field full">
      <label for="description">Your message</label>
      <textarea
        id="description"
        name="description"
        required
        minlength="10"
        maxlength="3000"
        placeholder="What do you do, and what would you like your website to make clearer?"
      ></textarea>
    </div>
  </fieldset>
  <p class="form-privacy">
    I’ll use your details only to reply to your enquiry. This website does not store your form
    details; they stay in your browser until you choose to open a draft.
  </p>
  <div class="brief-actions" hidden>
    <button class="button" type="submit" data-action="email">
      Open email draft
    </button>
    <button class="button secondary" type="submit" data-action="whatsapp">
      Open WhatsApp draft
    </button>
  </div>
  <div class="brief-tools" hidden>
    <button type="submit" data-action="copy">
      Copy project brief
    </button>
    <button type="submit" data-action="download">
      Download brief
    </button>
  </div>
  <p class="form-status" id="brief-status" role="status" aria-live="polite"></p>
  <div class="brief-preview" hidden>
    <h4>Your editable brief</h4>
    <label for="brief-text" class="form-note">
      Review the message or select and copy it yourself.
    </label>
    <textarea id="brief-text" spellcheck="false"></textarea>
    <p id="draft-links"></p>
  </div>
  <noscript>
    <p class="no-js-note">
      The brief tools need JavaScript. You can still{' '}
      <a class="text-link" href={`mailto:${site.email}`}>
        email Zakir directly
      </a>{' '}
      or use the WhatsApp contact link. No form data is sent from this page.
    </p>
  </noscript>
</form>
<script>
  import '../scripts/brief';
</script>
